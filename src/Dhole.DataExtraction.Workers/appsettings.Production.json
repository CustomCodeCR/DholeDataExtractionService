{
  "Workers": {
    "Schedule": {
      "IntervalSeconds": 5,
      "RunImmediately": true
    }
  },
  "EmailIngestion": {
    "MaxConcurrentExtractionJobs": 4,
    "AutoReprocessEnabled": true,
    "AutoReprocessBaseDelayMinutes": 10,
    "AutoReprocessMaxDelayMinutes": 1440,
    "AutoReprocessScanCount": 500,
    "MaxExtractionJobsPerRun": 100
  },
  "AI": {
    "AsyncEmail": {
      "Enabled": true,
      "StaleAiReprocessMinutes": 15
    },
    "AutomaticExtraction": {
      "TimeoutSeconds": 600,
      "ForceAiForEmail": false,
      "PreferAiResult": false,
      "RequireAiResult": false,
      "BypassAiWhenDeterministicRowsExist": true
    },
    "EmailFallback": {
      "TimeoutSeconds": 600
    }
  }
}
