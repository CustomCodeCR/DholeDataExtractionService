{
  "Workers": {
    "Schedule": {
      "IntervalSeconds": 5,
      "RunImmediately": true
    }
  },
  "EmailIngestion": {
    "MaxConcurrentExtractionJobs": 4,
    "AutoReprocessEnabled": true,
    "AutoReprocessBaseDelayMinutes": 30,
    "AutoReprocessMaxDelayMinutes": 1440,
    "AutoReprocessScanCount": 100,
    "MaxExtractionJobsPerRun": 24,
    "AutoReprocessMaxAttempts": 3,
    "ArchivePreviousMonths": true,
    "HistoricalArchiveBatchSize": 250
  },
  "AI": {
    "AsyncEmail": {
      "Enabled": true,
      "StaleAiReprocessMinutes": 15,
      "MaxOutstandingRequests": 12,
      "BackpressureDelaySeconds": 90
    },
    "AutomaticExtraction": {
      "TimeoutSeconds": 600,
      "ForceAiForEmail": false,
      "PreferAiResult": false,
      "RequireAiResult": false,
      "BypassAiWhenDeterministicRowsExist": true
    },
    "EmailFallback": {
      "TimeoutSeconds": 600
    }
  },
  "MarkItDown": {
    "Enabled": true,
    "TimeoutSeconds": 45,
    "MaxInputBytes": 26214400,
    "MaxOutputCharacters": 2000000
  }
}
