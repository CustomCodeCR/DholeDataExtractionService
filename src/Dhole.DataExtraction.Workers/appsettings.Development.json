{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "EmailIngestion": {
    "MaxMessagesPerSync": 25,
    "MaxExtractionJobsPerRun": 50,
    "ProcessingLeaseMinutes": 10,
    "Imap": {
      "MailboxTimeoutSeconds": 300,
      "ConnectTimeoutSeconds": 30,
      "CommandTimeoutSeconds": 60,
      "FetchTimeoutSeconds": 180,
      "MaxMessageBytes": 26214400,
      "TransientRetryCount": 3,
      "TransientRetryBaseDelaySeconds": 5,
      "TransientRetryMaxDelaySeconds": 30,
      "FailureRetryIntervalMinutes": 2
    },
    "Enabled": true,
    "StoragePath": "./storage/data-extraction"
  },
  "Pricing": {
    "ImportFromExtractionUrl": "http://192.168.1.12:5204/api/pricing/rate-import-batches/from-extraction",
    "TimeoutSeconds": 60
  },
  "Grpc": {
    "Clients": {
      "Config": {
        "Address": "http://192.168.1.12:5302",
        "TimeoutSeconds": 15,
        "CatalogCacheMinutes": 10
      },
      "AI": {
        "Address": "http://192.168.1.12:5307"
      }
    }
  },
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "dhole_data_extraction",
    "EnableHealthCheck": false
  },
  "AI": {
    "EmailFallback": {
      "Enabled": true,
      "ProfileKey": "pricing-email-analysis",
      "TimeoutSeconds": 180,
      "MaximumContentCharacters": 6000,
      "MaximumEmailContextCharacters": 1000
    },
    "AutomaticExtraction": {
      "TimeoutSeconds": 180,
      "Enabled": true,
      "Mode": "ConfidenceFallback",
      "AnalyzeEverySource": false,
      "ForceAiForEmail": false,
      "PreferAiResult": true,
      "RequireAiResult": false,
      "MinimumDeterministicConfidence": 75,
      "UseClassificationConfidenceForBypass": true,
      "BypassAiWhenDeterministicRowsExist": true
    }
  },
  "StorageService": {
    "Enabled": true,
    "Address": "http://192.168.1.12:5200/api/storage",
    "TimeoutSeconds": 120
  },
  "Storage": {
    "ExtractionFiles": {
      "RootPath": "./storage/data-extraction/pricing-imports"
    }
  }
}
