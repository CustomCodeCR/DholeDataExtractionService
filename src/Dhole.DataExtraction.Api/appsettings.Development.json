{
  "Auth": {
    "Jwt": {
      "RequireHttpsMetadata": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Http": {
    "Port": 5205
  },
  "Grpc": {
    "Server": {
      "Port": 5306,
      "MaxMessageSizeBytes": 67108864
    },
    "Clients": {
      "Config": {
        "Address": "http://192.168.0.12:5302",
        "TimeoutSeconds": 15,
        "CatalogCacheMinutes": 10
      }
    }
  },
  "EmailIngestion": {
    "MaxMessagesPerSync": 25,
    "MaxExtractionJobsPerRun": 50,
    "ProcessingLeaseMinutes": 10,
    "Enabled": true,
    "StoragePath": "./storage/data-extraction",
    "Imap": {
      "TransientRetryCount": 3,
      "TransientRetryBaseDelaySeconds": 5,
      "TransientRetryMaxDelaySeconds": 30,
      "FailureRetryIntervalMinutes": 2
    }
  },
  "Pricing": {
    "ImportFromExtractionUrl": "http://192.168.0.12:5204/api/pricing/rate-import-batches/from-extraction",
    "TimeoutSeconds": 60
  },
  "AI": {
    "EmailFallback": {
      "TimeoutSeconds": 180,
      "MaximumContentCharacters": 12000,
      "MaximumEmailContextCharacters": 8000,
      "Enabled": true,
      "ProfileKey": "pricing-email-analysis"
    },
    "AutomaticExtraction": {
      "TimeoutSeconds": 180,
      "Enabled": true,
      "Mode": "ConfidenceFallback",
      "AnalyzeEverySource": false,
      "ForceAiForEmail": false,
      "PreferAiResult": false,
      "RequireAiResult": false,
      "MinimumDeterministicConfidence": 75,
      "UseClassificationConfidenceForBypass": false,
      "BypassAiWhenDeterministicRowsExist": true
    }
  },
  "StorageService": {
    "Enabled": true,
    "Address": "http://192.168.0.12:5200/api/storage",
    "TimeoutSeconds": 120
  },
  "Storage": {
    "ExtractionFiles": {
      "RootPath": "./storage/data-extraction/pricing-imports"
    }
  }
}
